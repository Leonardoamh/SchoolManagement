{
	"name": "paymon",
	"version": "1.0.0",
	"description": "Cypress",
	"main": "index.js",
	"author": "lmillan",
	"license": "ISC",
	"type": "module",
	"scripts": {
		"test": "cypress open",
		"rm:reports": "rm reports/* || true",
		"file": "cypress run --browser firefox --reporter cypress-multi-reporters --reporter-options configFile=jsconfig.json --spec",
		"regression": "cypress run --browser firefox --reporter cypress-multi-reporters --reporter-options configFile=jsregression.json",
		"regression:report": "cypress run --browser firefox --reporter mochawesome --reporter-options reportDir=mochawesome-report,overwrite=false,html=false,json=true",
		"report:xml": "jrm ./reports/regression-report.xml \"./reports/suite-*.xml\"",
		"regression:chrome": "cypress run --browser chrome --reporter cypress-multi-reporters --reporter-options configFile=jsregression.json --spec",
		"report:json": "mochawesome-merge mochawesome-report/*.json>mochawesome.json",
		"report:html": "marge mochawesome.json",
		"delete:reports": "rm reports/suite-*.xml || true"
	},
	"devDependencies": {
		"@4tw/cypress-drag-drop": "2.2.2",
		"@badeball/cypress-cucumber-preprocessor": "12.2.0",
		"@bahmutov/cypress-esbuild-preprocessor": "2.1.5",
		"@esbuild-plugins/node-modules-polyfill": "0.1.4",
		"@faker-js/faker": "7.6.0",
		"@typescript-eslint/eslint-plugin": "5.53.0",
		"@typescript-eslint/parser": "5.53.0",
		"cypress": "12.7.0",
		"cypress-downloadfile": "1.2.3",
		"cypress-file-upload": "5.0.8",
		"cypress-mochawesome-reporter": "3.2.3",
		"cypress-multi-reporters": "1.6.2",
		"cypress-plugin-api": "2.6.1",
		"cypress-recurse": "1.24.0",
		"cypress-wait-until": "1.7.2",
		"cypress-xpath": "2.0.1",
		"eslint": "8.34.0",
		"eslint-plugin-only-warn": "1.1.0",
		"junit-report-merger": "4.0.0",
		"mocha": "10.2.0",
		"mocha-junit-reporter": "2.2.0",
		"mochawesome": "7.1.3",
		"mochawesome-merge": "4.2.2",
		"mochawesome-report-generator": "6.2.0",
		"prettier": "2.8.4",
		"typescript": "4.9.5"
	}
}
